# Памятники: страна, художественный стиль, год создания (P571)
# Monuments: country, artistic style, inception year (P571)
SELECT
  ?monument ?monumentLabel
  ?countryLabel
  ?styleLabel
  ?inceptionYear
WHERE {
  # экземпляр: памятник или подкласс
  ?monument wdt:P31/wdt:P279* wd:Q4989906 ;
            wdt:P17 ?country ;
            # стиль — обязательное поле
            wdt:P135 ?style .
  OPTIONAL {
    ?monument wdt:P571 ?inceptionDate .
    # только год, без полной даты
    BIND(YEAR(?inceptionDate) AS ?inceptionYear)
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,mul" . }
}
ORDER BY ?inceptionYear ?countryLabel
